# Primary (Vercel AI Gateway — automatic via OIDC on Vercel deployments)
AI_GATEWAY_API_KEY=
GATEWAY_MODEL=google/gemini-3.8-flash

# Optional local fallback when AI_GATEWAY_API_KEY / VERCEL_OIDC_TOKEN is not set
OPENROUTER_API_KEY=

# Optional kill switch ("1" or "true" disables /api/chat)
CHAT_DISABLED=0
